{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    // redaction.js is shipped verbatim from the server (#9235); JS is copied
    // and its .d.ts emitted, never type-checked.
    "allowJs": true,
    "checkJs": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    // "node" is required for the node-only ./project subpath (P2-2); the
    // browser-consumed barrel must not start using node globals.
    "types": ["node"]
  },
  "include": ["src"]
}
