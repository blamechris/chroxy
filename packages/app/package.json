{
  "name": "@chroxy/app",
  "version": "0.11.7",
  "description": "Chroxy mobile app",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --coverage",
    "test:coverage": "jest --coverage",
    "test:fast": "jest --coverage=false",
    "bundle-xterm": "node scripts/bundle-xterm.js",
    "postinstall": "node scripts/bundle-xterm.js"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|zustand|react-native-webview|@chroxy/store-core|@chroxy/protocol)"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ],
    "setupFilesAfterEnv": [
      "./jest.setup-after-env.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@chroxy/protocol$": "<rootDir>/../protocol/dist/index.js",
      "^@chroxy/protocol/schemas$": "<rootDir>/../protocol/dist/schemas/index.js"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/xterm-bundle.generated.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text-summary",
      "html",
      "lcov",
      "json-summary"
    ]
  },
  "dependencies": {
    "@chroxy/protocol": "^0.11.7",
    "@chroxy/store-core": "^0.11.7",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "expo": "^55.0.32",
    "expo-build-properties": "~55.0.18",
    "expo-camera": "~55.0.23",
    "expo-clipboard": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.41",
    "expo-device": "~55.0.21",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-haptics": "~55.0.18",
    "expo-image-picker": "~55.0.24",
    "expo-live-activity": "^0.4.2",
    "expo-local-authentication": "~55.0.18",
    "expo-localization": "~55.0.19",
    "expo-network": "~55.0.18",
    "expo-notifications": "~55.0.27",
    "expo-secure-store": "~55.0.18",
    "expo-speech-recognition": "^3.1.0",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.33",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-webview": "13.16.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "jest-expo": "~55.0.22",
    "typescript": "~5.9.2",
    "ws": "^8.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blamechris/chroxy.git",
    "directory": "packages/app"
  },
  "license": "MIT"
}
